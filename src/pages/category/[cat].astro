---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  return [
    { params: { cat: 'qs-rankings' } },
    { params: { cat: 'the-rankings' } },
    { params: { cat: 'arwu-rankings' } },
    { params: { cat: 'methodology' } },
    { params: { cat: 'data-analysis' } },
  ];
}

const { cat } = Astro.params;
const catNames = {
  'qs-rankings': 'QS Rankings',
  'the-rankings': 'THE Rankings',
  'arwu-rankings': 'ARWU Rankings',
  'methodology': 'Methodology',
  'data-analysis': 'Data Analysis',
};
const catName = catNames[cat] || cat;

const articles = await getCollection('articles', ({ data }) => data.category === cat && !data.draft);
articles.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
---

<BaseLayout
  title={`${catName} · UniRank`}
  description={`UniRank ${catName} — all articles sorted by date.`}
>
  <div class="max-w-4xl mx-auto px-6 py-12">
    <h1 class="font-heading text-3xl font-bold mb-2" style="color:var(--color-ur-ink)">{catName}</h1>
    <p class="mb-8" style="color:var(--color-ur-muted)">{articles.length} articles</p>
    <div class="space-y-4">
      {articles.map(article => (
        <a
          href={`/${article.slug}/`}
          class="block p-5 rounded-xl no-underline group transition-colors"
          style="background:var(--color-ur-card);border:1px solid var(--color-ur-line)"
        >
          <h2 class="font-heading text-xl font-bold group-hover:underline transition-colors" style="color:var(--color-ur-ink)">{article.data.title}</h2>
          <p class="text-sm mt-1" style="color:var(--color-ur-body)">{article.data.description}</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
