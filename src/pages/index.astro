---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles', ({ data }) => !data.draft);
articles.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());

const featured = articles.slice(0, 8);
const categories = [
    { slug: 'qs-rankings', name: 'QS Rankings', desc: 'QS Rankings' },
    { slug: 'the-rankings', name: 'THE Rankings', desc: 'THE Rankings' },
    { slug: 'arwu-rankings', name: 'ARWU Rankings', desc: 'ARWU Rankings' },
    { slug: 'methodology', name: 'Methodology', desc: 'Methodology' },
    { slug: 'data-analysis', name: 'Data Analysis', desc: 'Data Analysis' },
];

const homeSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'University Rankings',
  url: 'https://unirank.io',
  description: 'Data-driven analysis of global university rankings — compare QS, THE, ARWU, and US News methodologies. Understand what rankings really measure and make informed decisions.',
  inLanguage: 'en',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://unirank.io/?q={{search_term_string}}',
    'query-input': 'required name=search_term_string',
  },
});
---

<BaseLayout
  title="University Rankings, Decoded"
  description="Data-driven analysis of global university rankings — compare QS, THE, ARWU, and US News methodologies. Understand what rankings really measure and make informed decisions."
  schema={homeSchema}
>
  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-12 text-center">
    <p class="chapter-num text-aus-green text-lg mb-3">I</p>
    <h1 class="font-heading text-4xl md:text-5xl text-aus-ink font-bold leading-tight mb-4">
      University Rankings, Decoded
    </h1>
    <p class="text-xl text-aus-muted mb-6 font-heading">
      Independent analysis of global ranking systems
    </p>
    <p class="max-w-2xl mx-auto text-aus-muted leading-relaxed">
      We analyze university ranking methodologies across QS, THE, ARWU, and US News to help students, researchers, and administrators understand what the numbers actually mean. Every article is evidence-based, citing original ranking data and peer-reviewed research.
    </p>
  </section>

  <!-- Categories -->
  <section class="max-w-5xl mx-auto px-6 pb-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {categories.map(cat => (
        <a
          href={`/category/${cat.slug}/`}
          class="block p-5 border border-aus-green/10 rounded-sm hover:border-aus-red/30 hover:bg-white/50 transition-colors no-underline group"
        >
          <h2 class="font-heading text-lg text-aus-ink font-bold group-hover:text-aus-red transition-colors">{cat.name}</h2>
          <p class="text-sm text-aus-muted mt-1">{cat.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Featured Articles -->
  <section class="max-w-5xl mx-auto px-6 pb-20">
    <h2 class="font-heading text-2xl text-aus-ink font-bold mb-8">Latest Analysis</h2>
    <div class="grid md:grid-cols-2 gap-6">
      {featured.map(article => (
        <a
          href={`/${article.id}/`}
          class="block p-6 border border-aus-green/10 rounded-sm hover:border-aus-red/30 hover:bg-white/50 transition-colors no-underline group"
        >
          <span class="text-xs text-aus-green uppercase tracking-wide">{article.data.category}</span>
          <h3 class="font-heading text-xl text-aus-ink font-bold mt-1 mb-2 group-hover:text-aus-red transition-colors">{article.data.title}</h3>
          <p class="text-sm text-aus-muted leading-relaxed">{article.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
