---
const categories = [
    { slug: "qs-rankings", name: "QS Rankings" },
    { slug: "the-rankings", name: "THE Rankings" },
    { slug: "arwu-rankings", name: "ARWU Rankings" },
    { slug: "methodology", name: "Methodology" },
    { slug: "data-analysis", name: "Data Analysis" },
];
---

<header class="border-b border-aus-green/15 bg-aus-sand/95 backdrop-blur-sm sticky top-0 z-10">
  <nav class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="font-heading text-2xl text-aus-red font-bold tracking-wide no-underline">
      University Rankings
    </a>
    <div class="hidden xl:flex gap-1 text-sm">
      {categories.map(cat => (
        <a
          href={`/category/${cat.slug}/`}
          class="px-3 py-1.5 text-aus-muted hover:text-aus-ink hover:bg-aus-green/5 rounded-sm transition-colors no-underline"
        >
          {cat.name}
        </a>
      ))}
    </div>
    <a href="/about/" class="text-sm text-aus-muted hover:text-aus-ink no-underline hidden xl:block">
      About
    </a>
  </nav>
</header>

<style>


  /* MENU-CROWD-FIX-20260708: keep dense desktop menus from wrapping or crushing CTA buttons. */
  header nav a,
  .nav-links a,
  .nav-link,
  .nav-cta,
  .site-nav a {
    white-space: nowrap;
  }
  .nav-links,
  .site-nav {
    min-width: 0;
  }
  .site-nav.flex-wrap,
  nav.site-nav.flex-wrap {
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .site-nav.flex-wrap::-webkit-scrollbar,
  nav.site-nav.flex-wrap::-webkit-scrollbar {
    display: none;
  }
</style>
